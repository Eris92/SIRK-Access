<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers><add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" /></handlers>
    <aspNetCore processPath="dotnet" arguments=".\Sirk.Access.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
    <security><requestFiltering><requestLimits maxAllowedContentLength="115343360" /></requestFiltering></security>
  </system.webServer>
</configuration>
